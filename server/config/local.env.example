# Copy to server/config/local.env (or export in shell)

PORT=5001

# Image / IPFS
# IPFS_PROVIDER=auto|pinata|kubo|none
IPFS_PROVIDER=pinata
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Local Kubo alternative (avoid port clash with this API on 5001):
# IPFS_PROVIDER=kubo
# IPFS_ENABLED=true
# IPFS_API_URL=http://127.0.0.1:5002
