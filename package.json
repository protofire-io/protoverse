{
  "version": "1.0.0",
  "main": "./server.js",
  "scripts": {
    "dev:server": "nodemon ./server",
    "start:backend": "node ./server",
    "start:frontend": "npm install --prefix client && npm start --prefix client",
    "dev": "npx --yes concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "eject": "react-scripts eject",
    "test": "react-scripts test",
    "test:game": "jest --testPathPattern=game/__tests__ --forceExit",
    "test:contracts": "hardhat test",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "node": "hardhat node"
  },
  "private": "true",
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "ethers": "^6.15.0",
    "express": "^4.17.1",
    "express-mongo-sanitize": "^2.0.0",
    "express-rate-limit": "^5.1.3",
    "express-validator": "^6.6.1",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.20",
    "mongoose": "^5.10.2",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "pokersolver": "^2.1.4",
    "socket.io": "^2.3.0",
    "underscore": "^1.11.0",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^4.9.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "concurrently": "^5.3.0",
    "core-js": "^3.6.5",
    "hardhat": "^2.22.17",
    "jest": "^29.7.0",
    "mocha": "^10.8.2",
    "nodemon": "^2.0.4",
    "raf": "^3.4.1"
  }
}
